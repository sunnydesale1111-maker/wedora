datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  VENDOR
  PLANNER
  CUSTOMER
}

enum AvailabilityStatus {
  AVAILABLE
  TENTATIVELY_RESERVED
  FULLY_BOOKED
  UNAVAILABLE
  NOT_UPDATED
}

enum InquiryStatus {
  PENDING
  ACCEPTED
  DECLINED
  QUOTED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentType {
  CUSTOMER_TO_VENDOR
  PLANNER_TO_VENDOR
  CUSTOMER_TO_PLANNER
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  phone         String
  passwordHash  String   @map("password_hash")
  role          Role
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vendor        Vendor?
  events        Event[]           @relation("UserEvents")
  inquiries     Inquiry[]         @relation("UserInquiries")
  bookings      Booking[]         @relation("UserBookings")
  paidPayments  Payment[]         @relation("PayerPayments")
  receivedPayments Payment[]      @relation("PayeePayments")
  assignedTasks TimelineTask[]    @relation("UserAssignedTasks")
  aiConversations AIConversation[]
  familyProfiles CustomerFamilyProfile[] @relation("UserFamilyProfiles")
  clientProfiles OrganizerClientProfile[] @relation("OrganizerClientProfiles")
  eventParticipations EventParticipant[] @relation("UserEventParticipations")

  @@map("users")
}

model Vendor {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  businessName        String   @map("business_name")
  businessDescription String   @map("business_description")
  primaryCity         String   @map("primary_city")
  contactPerson       String?  @map("contact_person")
  businessAddress     String?  @map("business_address")
  verificationStatus  String   @default("VERIFIED") @map("verification_status")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  services            VendorService[]
  serviceAreas        VendorServiceArea[]
  quotations          Quotation[]
  bookings            Booking[]

  @@index([primaryCity])
  @@map("vendors")
}

model ServiceCategory {
  id           String          @id @default(uuid())
  categoryName String          @unique @map("category_name")
  slug         String          @unique
  description  String?
  services     VendorService[]

  @@map("service_categories")
}

model VendorService {
  id                           String          @id @default(uuid())
  vendorId                     String          @map("vendor_id")
  categoryId                   String          @map("category_id")
  serviceDescription          String          @map("service_description")
  maximumGuestCapacity         Int?            @map("maximum_guest_capacity")
  maximumSimultaneousBookings  Int             @default(1) @map("maximum_simultaneous_bookings")
  startingPrice                Float?          @map("starting_price")
  portfolioImages              String[]        @default([]) @map("portfolio_images")
  isActive                     Boolean         @default(true) @map("is_active")
  createdAt                    DateTime        @default(now()) @map("created_at")
  updatedAt                    DateTime        @updatedAt @map("updated_at")

  vendor                       Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category                     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  availability                 VendorAvailability[]
  inquiries                    Inquiry[]
  quotations                   Quotation[]
  bookings                     Booking[]

  @@index([vendorId])
  @@index([categoryId])
  @@map("vendor_services")
}

model VendorServiceArea {
  id        String   @id @default(uuid())
  vendorId  String   @map("vendor_id")
  city      String
  area      String

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([city, area])
  @@map("vendor_service_areas")
}

model VendorAvailability {
  id                String             @id @default(uuid())
  vendorServiceId   String             @map("vendor_service_id")
  availabilityDate  DateTime           @map("availability_date")
  status            AvailabilityStatus @default(AVAILABLE)
  availableCapacity Int                @default(1) @map("available_capacity")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  vendorService     VendorService      @relation(fields: [vendorServiceId], references: [id], onDelete: Cascade)

  @@unique([vendorServiceId, availabilityDate])
  @@index([availabilityDate, status])
  @@map("vendor_availability")
}

model Event {
  id              String         @id @default(uuid())
  ownerUserId     String         @map("owner_user_id")
  eventName       String         @map("event_name")
  eventType       String         @default("Wedding") @map("event_type")
  eventDate       DateTime       @map("event_date")
  city            String
  area            String
  guestCount      Int            @map("guest_count")
  estimatedBudget Float?         @map("estimated_budget")
  description     String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  owner           User           @relation("UserEvents", fields: [ownerUserId], references: [id], onDelete: Cascade)
  organizerClientId String?      @map("organizer_client_id")
  organizerClient OrganizerClientProfile? @relation("ClientProfileEvents", fields: [organizerClientId], references: [id], onDelete: SetNull)
  profileAccess   CustomerProfileEventAccess[] @relation("EventProfileAccess")
  participants    EventParticipant[]
  inquiries       Inquiry[]
  quotations      Quotation[]
  bookings        Booking[]
  payments        Payment[]
  timelineTasks   TimelineTask[]
  aiConversations AIConversation[]

  @@index([ownerUserId])
  @@index([eventDate])
  @@map("events")
}

model Inquiry {
  id              String        @id @default(uuid())
  eventId         String        @map("event_id")
  vendorServiceId String        @map("vendor_service_id")
  requesterId     String        @map("requester_id")
  status          InquiryStatus @default(PENDING)
  requirements    String
  guestCount      Int?          @map("guest_count")
  eventDate       DateTime      @map("event_date")
  budget          Float?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendorService   VendorService @relation(fields: [vendorServiceId], references: [id], onDelete: Cascade)
  requester       User          @relation("UserInquiries", fields: [requesterId], references: [id], onDelete: Cascade)
  quotations      Quotation[]

  @@index([eventId])
  @@index([vendorServiceId])
  @@index([requesterId])
  @@map("inquiries")
}

model Quotation {
  id                String          @id @default(uuid())
  inquiryId         String          @map("inquiry_id")
  eventId           String          @map("event_id")
  vendorId          String          @map("vendor_id")
  vendorServiceId   String          @map("vendor_service_id")
  quotedAmount      Float           @map("quoted_amount")
  serviceScope      String          @map("service_scope")
  includedServices  String?         @map("included_services")
  additionalCharges Float           @default(0) @map("additional_charges")
  validUntil        DateTime        @map("valid_until")
  paymentTerms      String?         @map("payment_terms")
  status            QuotationStatus @default(SENT)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  inquiry           Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor            Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorService     VendorService   @relation(fields: [vendorServiceId], references: [id], onDelete: Cascade)
  bookings          Booking[]

  @@index([inquiryId])
  @@index([vendorId])
  @@index([eventId])
  @@map("quotations")
}

model Booking {
  id              String        @id @default(uuid())
  eventId         String        @map("event_id")
  quotationId     String        @map("quotation_id")
  vendorId        String        @map("vendor_id")
  vendorServiceId String        @map("vendor_service_id")
  customerId      String        @map("customer_id")
  status          BookingStatus @default(PENDING_CONFIRMATION)
  agreedAmount    Float         @map("agreed_amount")
  eventDate       DateTime      @map("event_date")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quotation       Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorService   VendorService @relation(fields: [vendorServiceId], references: [id], onDelete: Cascade)
  customer        User          @relation("UserBookings", fields: [customerId], references: [id], onDelete: Cascade)
  payments        Payment[]
  timelineTasks   TimelineTask[]

  @@index([eventId])
  @@index([vendorId])
  @@index([vendorServiceId])
  @@index([customerId])
  @@index([eventDate])
  @@map("bookings")
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String?       @map("booking_id")
  eventId        String        @map("event_id")
  payerId        String        @map("payer_id")
  payeeId        String        @map("payee_id")
  amount         Float
  paymentType    PaymentType   @map("payment_type")
  status         PaymentStatus @default(PENDING)
  paymentPurpose String        @map("payment_purpose")
  isSimulated    Boolean       @default(true) @map("is_simulated")
  transactionRef String        @unique @map("transaction_ref")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  booking        Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payer          User          @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Cascade)
  payee          User          @relation("PayeePayments", fields: [payeeId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([eventId])
  @@index([payerId])
  @@index([payeeId])
  @@map("payments")
}

model TimelineTask {
  id               String     @id @default(uuid())
  eventId          String     @map("event_id")
  taskName         String     @map("task_name")
  deadline         DateTime?
  assignedUserId   String?    @map("assigned_user_id")
  relatedBookingId String?    @map("related_booking_id")
  status           TaskStatus @default(PENDING)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedUser     User?      @relation("UserAssignedTasks", fields: [assignedUserId], references: [id], onDelete: SetNull)
  relatedBooking   Booking?   @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([assignedUserId])
  @@map("timeline_tasks")
}

model AIConversation {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  eventId           String?     @map("event_id")
  title             String?     @default("Vendor Discovery Chat")
  conversationState Json        @default("{}") @map("conversation_state")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event             Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  messages          AIMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id              String         @id @default(uuid())
  conversationId  String         @map("conversation_id")
  role            String         // user, assistant, system
  content         String
  extractedParams Json?          @map("extracted_params")
  createdAt       DateTime       @default(now()) @map("created_at")

  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model CustomerFamilyProfile {
  id            String   @id @default(uuid())
  primaryUserId String   @map("primary_user_id")
  name          String
  email         String
  relationship  String   @default("Family Member")
  avatar        String   @default("avatar-1")
  role          String   @default("FAMILY_MEMBER") // PRIMARY or FAMILY_MEMBER
  permissions   Json     @default("{\"canViewEvents\": true, \"canViewVendors\": true, \"canViewTasks\": true, \"canViewBudgets\": true, \"canViewBookings\": true, \"canMakeBookings\": false, \"canManagePayments\": false, \"canManageEvents\": false, \"canModifyBudgets\": false, \"canUpdateTasks\": false, \"canManageProfiles\": false, \"canInviteMembers\": false}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  primaryUser   User     @relation("UserFamilyProfiles", fields: [primaryUserId], references: [id], onDelete: Cascade)
  sharedEvents  CustomerProfileEventAccess[]

  @@index([primaryUserId])
  @@index([email])
  @@map("customer_family_profiles")
}

model CustomerProfileEventAccess {
  id            String   @id @default(uuid())
  profileId     String   @map("profile_id")
  eventId       String   @map("event_id")
  canViewBudget Boolean  @default(true) @map("can_view_budget")
  createdAt     DateTime @default(now()) @map("created_at")

  profile       CustomerFamilyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  event         Event                 @relation("EventProfileAccess", fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([profileId, eventId])
  @@index([profileId])
  @@index([eventId])
  @@map("customer_profile_event_access")
}

model OrganizerClientProfile {
  id              String   @id @default(uuid())
  organizerUserId String   @map("organizer_user_id")
  clientName      String   @map("client_name")
  clientEmail     String   @map("client_email")
  clientPhone     String   @map("client_phone")
  company         String?
  status          String   @default("ACTIVE") // ACTIVE or ARCHIVED
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organizer       User     @relation("OrganizerClientProfiles", fields: [organizerUserId], references: [id], onDelete: Cascade)
  events          Event[]  @relation("ClientProfileEvents")

  @@index([organizerUserId])
  @@map("organizer_client_profiles")
}

model EventParticipant {
  id           String    @id @default(uuid())
  eventId      String    @map("event_id")
  userId       String?   @map("user_id")
  name         String
  email        String?
  phone        String?
  role         String    @default("FAMILY_MEMBER") // PRIMARY, CO_HOST, FAMILY_MEMBER, GUEST
  relationship String?   @default("Participant")
  isPrimary    Boolean   @default(false) @map("is_primary")
  status       String    @default("PENDING") // PENDING or ACCEPTED
  canEdit      Boolean   @default(false) @map("can_edit")
  invitedAt    DateTime  @default(now()) @map("invited_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User?     @relation("UserEventParticipations", fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
  @@index([email])
  @@map("event_participants")
}
